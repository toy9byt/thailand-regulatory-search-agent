# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments & local env
.env
.env.local
.env.*.local
venv/
.venv/
env/

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Linters
.ruff_cache/
.mypy_cache/

# Databases & local state
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Credentials, Keys & Secrets (Strict Zero-Leakage)
*.pem
*.key
*.crt
*credential*.json
*secret*.json
service-account*.json
token.json

