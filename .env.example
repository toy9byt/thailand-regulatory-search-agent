# ==============================================================================
# Thailand Private Banking Regulatory Search Agent - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your local credentials.
# NEVER commit your actual .env file to public version control.

# Google Cloud Project & Region
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1

# Google GenAI / Gemini API Key (Alternative to Application Default Credentials)
# Obtain from Google Cloud Console or Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Strategic Model Routing Configuration
# Fast Triage & Parsing Tier
MODEL_FAST=gemini-3.7-flash
# Deep Reasoning & Statutory Synthesis Tier
MODEL_PRO=gemini-3.1-pro
MODEL_FLASH_THINKING=gemini-3.7-flash
MODEL_ROUTING_STRATEGY=PURE_FLASH_EXTENDED_THINKING
THINKING_BUDGET=4096

# Observability & Tracing (OpenTelemetry & Cloud Trace)
ENABLE_OPENTELEMETRY=true
OTEL_SERVICE_NAME=thailand-regulatory-search-agent
LOG_LEVEL=INFO

# Persistent Session Storage
SESSION_STORAGE_TYPE=sqlite
SESSION_DB_PATH=sessions.sqlite

# Security & Compliance Scope
TARGET_ENTITY_SCOPE=PRIVATE_COMMERCIAL_BANK
ENABLE_PII_REDACTION=true
ENABLE_HITL_GATE=true
